# Copy this file to .env and fill in your values.

# Set to true to run with built-in sample data (no SonarQube needed).
DEMO_MODE=false

# SonarQube server and a user token (My Account → Security → Generate Token).
SONARQUBE_URL=http://localhost:9000
SONARQUBE_TOKEN=

# Port for this API.
PORT=4000

# Allowed browser origins (comma-separated), or * for any.
CORS_ORIGIN=http://localhost:5173
